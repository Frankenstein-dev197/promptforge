# Application
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# Auth
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"
SESSION_COOKIE_NAME="pf_session"

# Optional AI provider (server-side only). Leave empty to use the local deterministic generator.
OPENAI_API_KEY=""

# OAuth providers (server-side only — never expose secrets to the client).
# Leave empty to disable a provider; clicking an unconfigured button returns a clear configuration error.
# Google: https://console.cloud.google.com/apis/credentials (Authorized redirect URI: <APP_URL>/api/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers (Authorization callback URL: <APP_URL>/api/auth/oauth/github/callback)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
